{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf /)",
      "Bash(sudo rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(sudo rm -rf ~)",
      "Read(.env)",
      "Read(.env.*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git reset --hard*)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "model": "sonnet",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.local/bin/skill-registry-refresh\" \"${CLAUDE_PROJECT_DIR:-$PWD}\""
          }
        ]
      },
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/bin/apply-agent-patches.sh --quiet"
          }
        ]
      },
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/triangulate-handoff.sh"
          }
        ]
      },
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/triangulate-main-checkout-guard.sh"
          }
        ]
      },
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/engram-context-pointer.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/engram-git-sync.sh pull",
            "timeout": 60
          }
        ],
        "matcher": "startup|resume|clear"
      },
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/strip-1m-model.sh"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/context-budget-measure.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/context-budget.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/force-push-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-unbounded-polls.sh"
          }
        ]
      },
      {
        "matcher": "Agent|Workflow|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/track-bg-launch.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/deploy-checkout-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/pinned-tool-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/triangulate-main-checkout-guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/reap-stale-polls.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/report-live-children.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/block-unacked-bg.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/context-budget-measure.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/receipt-dispatch-guard.sh",
            "timeout": 2
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/engram-git-sync.sh push",
            "timeout": 60
          }
        ]
      }
    ]
  },
  "enableWorkflows": true,
  "workflowSizeGuideline": "small",
  "workflowKeywordTriggerEnabled": true,
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "engram@engram": false,
    "swift-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "engram": {
      "source": {
        "source": "github",
        "repo": "Gentleman-Programming/engram"
      }
    }
  },
  "effortLevel": "medium",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "teammateMode": "in-process",
  "isolatePeerMachines": true,
  "crossSessionInbound": "accept",
  "agentPushNotifEnabled": true,
  "autoMemoryDirectory": "~/.claude/memory"
}

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Consolidador nocturno de memoria.

  Sólo propone: nunca aplica cambios automáticamente. Aplicar sigue siendo una
  decisión humana mediante `memory-consolidate review` / la acción manual de
  aplicación. --if-idle evita apilar propuestas o gastar modelo mientras haya
  una pendiente de revisión.

  launchd no hereda el PATH del shell. Se declara explícitamente para encontrar
  claude, memory-snapshot, memory-lint y el python3 instalado en /usr/local.

  __HOME__ lo sustituye bootstrap.sh: launchd no expande variables en las rutas.
-->
<plist version="1.0"><dict>
  <key>Label</key><string>com.cocoa.memory-consolidate</string>
  <key>ProgramArguments</key><array>
    <string>__HOME__/.local/bin/memory-consolidate</string>
    <string>propose</string>
    <string>--if-idle</string>
  </array>
  <key>StartCalendarInterval</key><dict>
    <key>Hour</key><integer>3</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>EnvironmentVariables</key><dict>
    <key>PATH</key><string>__HOME__/.local/bin:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin</string>
    <key>HOME</key><string>__HOME__</string>
  </dict>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/memory-consolidate.stdout.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/memory-consolidate.stderr.log</string>
</dict></plist>

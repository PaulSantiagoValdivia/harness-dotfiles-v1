#!/usr/bin/env bash
# triangulate — prepara worktrees backend/panel/app y abre la topología nativa
# correcta en cmux para Claude o Codex.
#
# Uso rápido:
#   triangulate claude <feature-slug> [repos]
#   triangulate codex  <feature-slug> [repos]
#   triangulate resume <repo-name> <feature-slug> [--force]
#
# Compatibilidad:
#   triangulate start <feature-slug> [repos] [--agent claude|codex|opencode]
#   triangulate plan  <agent> <feature-slug> [repos]
#   triangulate stop  <feature-slug> [repos]        (solo diagnostica, no borra)
#   triangulate close <feature-slug> [repos] [--dry-run]  (remueve worktrees limpios)
#   triangulate list
#
# Claude abre una sesión top-level nombrada por repositorio. Codex abre un solo
# primary en backend y le concede panel/app mediante --add-dir; el prompt inicial
# exige que cree exactamente dos agent threads. Tres Codex top-level no son una
# triangulación coordinada porque no comparten un canal peer-to-peer nativo.

set -euo pipefail

CONFIG="${TRIANGULATE_CONFIG:-$HOME/.claude/triangulate.conf}"
DEFAULT_AGENT="${TRIANGULATE_AGENT:-claude}"

[ -f "$CONFIG" ] || { echo "no existe $CONFIG" >&2; exit 1; }

repo_path() {
  awk -F= -v n="$1" '$1==n {print substr($0, index($0,"=")+1)}' "$CONFIG"
}

repo_names() {
  awk -F= 'NF==2 && $1 !~ /^#/ {print $1}' "$CONFIG"
}

default_repos() {
  repo_names | paste -sd, -
}

validate_agent() {
  case "$1" in
    claude|codex|opencode) ;;
    *) echo "agente no soportado: $1 (usa claude, codex u opencode)" >&2; exit 1 ;;
  esac
}

# Extrae "tipo:número" de una respuesta como:
# OK surface:3 pane:3 workspace:2
cmux_ref() {
  grep -oE "$1:[0-9]+" <<< "$2" | head -1 || true
}

blocked() { echo "BLOCKED: $*" >&2; exit 1; }

validate_fresh_identity() {
  python3 - "$CONFIG" "$repos" "$slug" "${TRIANGULATE_CHANGES_CONFIG:-$HOME/.claude/triangulate-changes.conf}" <<'PYTHON'
import os, pathlib, re, subprocess, sys
config, selected, slug, alias_file = sys.argv[1:]
def identifier(value):
    if not re.fullmatch(r'[a-z0-9][a-z0-9-]*', value): raise ValueError('invalid identifier')
def mapping(path):
    result = {}
    for line in pathlib.Path(path).read_text().splitlines():
        if not line.strip() or line.startswith('#'): continue
        key, sep, value = line.partition('=')
        if not sep or not value or key in result: raise ValueError('invalid/duplicate mapping')
        result[key] = value
    return result
try:
    identifier(slug)
    configured = mapping(config)
    if sorted(selected.split(',')) != ['app','back','front'] or set(configured) != {'app','back','front'}:
        raise ValueError('exactly back/front/app required')
    roots, common = {}, []
    for role, raw in configured.items():
        if not pathlib.Path(raw).is_absolute(): raise ValueError('absolute repository roots required')
        root = pathlib.Path(raw).resolve(strict=True)
        top = subprocess.check_output(['git','-C',str(root),'rev-parse','--show-toplevel'],text=True).strip()
        if root != pathlib.Path(top).resolve(): raise ValueError('not a repository root')
        roots[role] = root
        common.append(subprocess.check_output(['git','-C',str(root),'rev-parse','--path-format=absolute','--git-common-dir'],text=True).strip())
        target = root / '.claude/worktrees' / ('triangulate-' + slug)
        if not target.resolve().is_relative_to(root): raise ValueError('escaping target')
    if len(set(common)) != 3: raise ValueError('duplicate repository ownership')
    aliases = mapping(alias_file) if os.path.lexists(alias_file) else {}
    for key, value in aliases.items(): identifier(key); identifier(value)
    change = aliases.get(slug, slug)
    authority = roots['back'] / '.claude/worktrees' / ('triangulate-' + slug) / 'openspec/changes' / change
    if not authority.resolve().is_relative_to(roots['back']): raise ValueError('escaping authority')
    if change != slug and (authority.parent / slug).exists(): raise ValueError('conflicting exact authority')
    print(authority)
except (OSError, ValueError, subprocess.SubprocessError) as error:
    print(f'BLOCKED: {error}; correct repo/alias mapping, never guess another plan',file=sys.stderr)
    sys.exit(1)
PYTHON
}

assert_fresh_targets() {
  local i refs
  for i in "${!WORKTREES[@]}"; do
    [ ! -e "${WORKTREES[$i]}" ] && [ ! -L "${WORKTREES[$i]}" ] || blocked "target exists: ${WORKTREES[$i]}; contact current owner"
    refs=$(git -C "${REPO_BASES[$i]}" for-each-ref --format='%(refname)' "refs/heads/triangulate/$slug") || blocked 'refs unreadable'
    [ -z "$refs" ] || blocked "branch already exists: triangulate/$slug"
  done
}

release_reservations() {
  local lock rc=$?
  [ "$rc" -eq 0 ] || echo "BLOCKED: partial launch; preserve ${WORKTREES[*]} and any opened sessions for owner recovery" >&2
  for lock in "${RESERVATIONS[@]:-}"; do
    [ -n "$lock" ] || continue
    if [ ! -L "$lock" ] && [ "$(cat "$lock/nonce" 2>/dev/null)" = "$NONCE" ]; then
      rm "$lock/nonce"; rmdir "$lock" || true
    fi
  done
}

reserve_launch() {
  local base common lock directories=""
  RESERVATIONS=(); NONCE="$$-$RANDOM-$RANDOM"
  trap release_reservations EXIT
  trap 'exit 130' INT TERM
  for base in "${REPO_BASES[@]}"; do
    common=$(git -C "$base" rev-parse --path-format=absolute --git-common-dir) || blocked 'Git ownership unreadable'
    directories+="$common"$'\n'
  done
  while IFS= read -r common; do
    lock="$common/triangulate-launch.lock"
    mkdir "$lock" 2>/dev/null || blocked "unknown reservation: $lock; preserve owner state"
    printf '%s\n' "$NONCE" > "$lock/nonce"
    RESERVATIONS+=("$lock")
  done < <(printf '%s' "$directories" | sort)
  assert_fresh_targets
}

usage() {
  cat >&2 <<EOF
Uso:
  triangulate claude <feature-slug> [repos, default: $(default_repos)]
  triangulate codex  <feature-slug> [repos, default: $(default_repos)]
  triangulate resume <repo-name> <feature-slug> [--force]
  triangulate start  <feature-slug> [repos] [--agent claude|codex|opencode]
  triangulate plan   <agent> <feature-slug> [repos]
  triangulate stop   <feature-slug> [repos]        (solo diagnostica)
  triangulate close  <feature-slug> [repos] [--dry-run]  (remueve worktrees limpios)
  triangulate waits  <feature-slug> [repos]        (qué espera cada pane: último usuario/asistente)
  triangulate seed   <feature-slug> [repos]        (re-siembra .env ignorados en worktrees ya creados)
  triangulate list
EOF
  exit 1
}

load_repositories() {
  local repos="$1" name base
  IFS=',' read -ra REPOS <<< "$repos"
  REPO_BASES=()
  WORKTREES=()
  CANONICAL_INDEX=0

  for i in "${!REPOS[@]}"; do
    name="${REPOS[$i]}"
    base="$(repo_path "$name")"
    [ -n "$base" ] || {
      echo "repo desconocido: $name (revisa $CONFIG)" >&2
      exit 1
    }
    REPO_BASES+=("$base")
    WORKTREES+=("$base/.claude/worktrees/triangulate-$slug")
    if [ "$name" = back ]; then
      CANONICAL_INDEX="$i"
    fi
  done
}

ensure_worktrees() {
  local i base wt branch base_ref
  branch="triangulate/$slug"

  for i in "${!REPOS[@]}"; do
    base="${REPO_BASES[$i]}"
    wt="${WORKTREES[$i]}"
    git -C "$base" rev-parse --git-dir >/dev/null 2>&1 || {
      echo "no es un repositorio Git: $base" >&2
      exit 1
    }

    git -C "$base" fetch origin
    git -C "$base" show-ref --verify --quiet refs/remotes/origin/dev || {
      echo "BLOCKED: origin/dev es obligatoria y no existe en ${REPOS[$i]}: $base" >&2
      echo "No se creará una triangulación desde main u otra rama." >&2
      exit 1
    }
    base_ref=origin/dev

    [ ! -e "$wt" ] && [ ! -L "$wt" ] || blocked "target appeared during fetch: $wt"
    git -C "$base" worktree add -b "$branch" "$wt" "$base_ref" >/dev/null
    echo "worktree creado: $wt (rama $branch desde $base_ref)"
    seed_worktree_includes "$base" "$wt"
  done
}

# Un worktree nace SIN los archivos que git ignora: .env.*.local, ios/.asc.env…
# Incidente 2026-09-17/18 (demo Agropartners): el usuario cargó E2E_QA_PIN en
# el worktree de una triangulación y la siguiente, del mismo repo, arrancó sin
# él; tres sesiones se lo pidieron de nuevo durante 8 horas. Conductor
# resolvía esto con `.worktreeinclude` (cocoa_v2 ya lo tiene) y triangulate lo
# ignoraba. Semántica: cada línea es un pathspec de git relativo a la raíz;
# sólo se copian archivos que git YA ignora (nunca vuelve trackeado a nada),
# nunca se pisa un archivo existente. Sin `.worktreeinclude`, el default es el
# de Conductor: los `.env*` de la raíz.
seed_worktree_includes() {
  local base="$1" wt="$2" inc="$1/.worktreeinclude" pat rel n=0 src="default .env*"
  local -a patterns=()
  if [ -f "$inc" ]; then
    src=".worktreeinclude"
    while IFS= read -r pat || [ -n "$pat" ]; do
      pat="${pat%%#*}"
      pat="${pat#"${pat%%[![:space:]]*}"}"
      pat="${pat%"${pat##*[![:space:]]}"}"
      [ -n "$pat" ] && patterns+=("$pat")
    done < "$inc"
  else
    patterns=('.env*')
  fi
  [ "${#patterns[@]}" -gt 0 ] || { echo "  sin patrones en $inc: no se siembra nada"; return 0; }
  while IFS= read -r rel; do
    [ -n "$rel" ] || continue
    case "$rel" in .claude/worktrees/*|*/node_modules/*|node_modules/*) continue ;; esac
    [ -f "$base/$rel" ] || continue
    [ ! -e "$wt/$rel" ] || continue
    mkdir -p "$wt/$(dirname "$rel")"
    cp -p "$base/$rel" "$wt/$rel" && n=$((n + 1))
  done < <(git -C "$base" ls-files --others --ignored --exclude-standard -- "${patterns[@]}" 2>/dev/null)
  echo "  sembrados $n archivo(s) ignorados desde $src (credenciales locales, nunca trackeadas)"
}

# Qué está esperando cada pane de una triangulación, en UN solo lugar: último
# mensaje del usuario y último texto del asistente por sesión, leídos de los
# transcripts locales (~/.claude/projects/<cwd codificado>/*.jsonl). Nace del
# mismo incidente: el usuario respondió una decisión en un pane, el coordinador
# la esperaba en otro, y los dos creyeron que el otro estaba frenado.
show_waits() {
  local i wt name
  for i in "${!REPOS[@]}"; do
    name="${REPOS[$i]}"
    wt="${WORKTREES[$i]}"
    python3 - "$name" "$wt" "${TRIANGULATE_PROJECTS_DIR:-$HOME/.claude/projects}" <<'PY'
import json, pathlib, re, sys
name, wt, projects = sys.argv[1], sys.argv[2], sys.argv[3]
enc = re.sub(r'[^A-Za-z0-9]', '-', wt)
d = pathlib.Path(projects) / enc
files = sorted(d.glob('*.jsonl'), key=lambda p: p.stat().st_mtime) if d.is_dir() else []
print(f"== {name}  ({wt})")
if not files:
    print("   sin transcript local: la sesión nunca arrancó en este worktree")
    sys.exit(0)
last_user = last_asst = None
for line in files[-1].open(encoding='utf-8', errors='ignore'):
    try:
        o = json.loads(line)
    except ValueError:
        continue
    t = o.get('type')
    if t not in ('user', 'assistant'):
        continue
    c = o.get('message', {}).get('content')
    if isinstance(c, list):
        c = ' '.join(x.get('text', '') for x in c if isinstance(x, dict) and x.get('type') == 'text')
    if not isinstance(c, str) or not c.strip():
        continue
    c = c.strip()
    if t == 'user':
        if c.startswith(('<', '[Cross-session', 'Another Claude session sent a message')) or 'system-reminder' in c[:80]:
            continue
        last_user = (o.get('timestamp', '')[11:19], c)
    else:
        last_asst = (o.get('timestamp', '')[11:19], c)
def show(label, item):
    if not item:
        print(f"   {label}: (nada)")
        return
    ts, text = item
    text = re.sub(r'\s+', ' ', text)
    print(f"   {label} {ts}Z: {text[:400]}{'…' if len(text) > 400 else ''}")
show("usuario  ", last_user)
show("asistente", last_asst)
PY
  done
}

ensure_devtools() {
  local attempt
  if curl -fsS --max-time 1 http://localhost:7777/api/health >/dev/null 2>&1; then
    echo "Cocoa DevTools activo en http://localhost:7777"
    return 0
  fi
  command -v devtools >/dev/null 2>&1 || {
    echo "no existe el launcher 'devtools'; ejecuta nuevamente el bootstrap" >&2
    return 1
  }

  COCOA_DEVTOOLS_NO_BROWSER=1 nohup devtools \
    >"${TMPDIR:-/tmp}/cocoa-devtools.log" 2>&1 &
  for attempt in {1..30}; do
    if curl -fsS --max-time 1 http://localhost:7777/api/health >/dev/null 2>&1; then
      echo "Cocoa DevTools iniciado en http://localhost:7777"
      return 0
    fi
    sleep 0.1
  done
  echo "Cocoa DevTools no respondió; revisa ${TMPDIR:-/tmp}/cocoa-devtools.log" >&2
  return 1
}

create_workspace() {
  local cwd="$1" out pane_id
  out="$(cmux workspace create --name "$slug" --cwd "$cwd" --focus false)"
  workspace_id="$(cmux_ref workspace "$out")"
  [ -n "$workspace_id" ] || {
    echo "no pude leer el workspace de: $out" >&2
    exit 1
  }

  pane_id=""
  for _ in 1 2 3 4 5 6; do
    out="$(cmux list-panes --workspace "$workspace_id" 2>&1 || true)"
    pane_id="$(cmux_ref pane "$out")"
    [ -n "$pane_id" ] && break
    sleep 0.5
  done
  [ -n "$pane_id" ] || {
    echo "no pude leer el pane inicial de: $out" >&2
    exit 1
  }
  CREATED_PANE_ID="$pane_id"
}

create_pane() {
  local direction="$1" out pane_id
  out="$(cmux new-pane --direction "$direction" --workspace "$workspace_id" --focus false)"
  pane_id="$(cmux_ref pane "$out")"
  [ -n "$pane_id" ] || {
    echo "no pude leer el pane de: $out" >&2
    exit 1
  }
  CREATED_PANE_ID="$pane_id"
}

find_surface() {
  local pane_id="$1" out surface_id
  surface_id=""
  for _ in 1 2 3 4 5 6; do
    out="$(cmux list-pane-surfaces --workspace "$workspace_id" --pane "$pane_id" 2>&1 || true)"
    surface_id="$(cmux_ref surface "$out")"
    [ -n "$surface_id" ] && break
    sleep 0.5
  done
  [ -n "$surface_id" ] || {
    echo "no pude leer la surface del pane $pane_id: $out" >&2
    exit 1
  }
  printf '%s\n' "$surface_id"
}

shell_join() {
  local result="" quoted item
  for item in "$@"; do
    printf -v quoted '%q' "$item"
    result+="${result:+ }$quoted"
  done
  printf '%s\n' "$result"
}

# One instruction contract for both plan and dispatch; not a transport service.
build_packet() {
  local role="$1" i own=""
  case "$role" in back|front|app) ;; *) blocked "invalid packet role: $role" ;; esac
  for i in "${!REPOS[@]}"; do
    [ "${REPOS[$i]}" != "$role" ] || own="${WORKTREES[$i]}"
  done
  [ -n "$own" ] || blocked "missing packet role: $role"
  cat <<EOF
Triangula automáticamente el cambio '$slug' usando coordinación nativa, no solo diagnóstico.
Activa el skill triangulation-orchestrator antes de trabajar.
change=$slug
run_nonce=$RUN_NONCE
role=$role
lead=back
worktree=$own
write_boundary=$own
authority=$CANONICAL_IDENTITY
$AUTHORITY_CONTEXT
Canonical artifacts: $CANONICAL_IDENTITY/proposal.md; $CANONICAL_IDENTITY/specs/; $CANONICAL_IDENTITY/design.md; $CANONICAL_IDENTITY/tasks.md
EOF
  for i in "${!REPOS[@]}"; do printf '%s=%s\n' "${REPOS[$i]}" "${WORKTREES[$i]}"; done
  if [ "$role" = back ]; then
    echo 'Own backend implementation, canonical planning and consolidation; never write sibling repositories.'
  else
    echo 'Never create another plan. Do not delegate. Discover the exact back lead and ACK only your own boundary.'
  fi
  if [ "$agent" = claude ]; then
    echo 'Use native ListAgents/SendMessage; match observed identity, role and exact worktree, not session name alone.'
  else
    echo 'Use this primary for back; spawn exactly two native agent threads front and app. Explicitly forward role, own worktree/write_boundary, all sibling and artifact paths, run_nonce and this readiness contract to each child. Do not delegate from children. No other top-level Codex.'
  fi
  cat <<'EOF'
Missing artifacts permit read-only discovery and canonical SDD planning by back only, not implementation; never fabricate hashes.
Before implementation send HELLO(request_id, run_nonce, native_identity, role, worktree, authority, contract_revision_sha256, task, write_boundary) through the native mailbox; workers ACK the same fields after reading actual artifacts and confirming scope.
Require two distinct worker ACKs and observed bidirectional delivery before dispatch. Reject missing, duplicate, stale, late, wrong-role, wrong-path, wrong-authority or mismatched hash/identity/scope ACKs; duplicates never create assignments.
Use at most two discovery attempts: initial plus one event-triggered retry, or one scheduled retry within 10 seconds if no event. Missing peers after second discovery means BLOCKED; no polling. Allow one follow-up per peer, same request_id, within 120 seconds from HELLO on the coordinator clock.
On deadline, unavailable tools or inbox refusal report BLOCKED with cause; preserve owners/data, no security bypass or invented channel.
Replacement or revision changes invalidate readiness: require fresh ACK; replacement also needs stopped owner and clean handoff. One writer per repository, no implicit transfer.
These are prompt instructions, not enforced permissions or proof of compliance. Launch/live coordination UNTESTED until actual native exchanges and safe follow-up are retained.
EOF
}

build_claude_launch() {
  CLAUDE_LAUNCH="$(shell_join claude --name "$slug-$1" "$(build_packet "$1")")"
}

build_codex_launch() {
  local i canonical
  canonical="${WORKTREES[$CANONICAL_INDEX]}"

  [ "${#REPOS[@]}" -eq 3 ] || {
    echo "Codex coordinado requiere exactamente tres repositorios" >&2
    exit 1
  }
  [ "${REPOS[$CANONICAL_INDEX]}" = back ] || {
    echo "Codex coordinado requiere el rol 'back' como autoridad canónica" >&2
    exit 1
  }

  CODEX_ARGS=(codex --dangerously-bypass-approvals-and-sandbox --cd "$canonical")
  for i in "${!REPOS[@]}"; do
    [ "$i" -eq "$CANONICAL_INDEX" ] || CODEX_ARGS+=(--add-dir "${WORKTREES[$i]}")
  done

  CODEX_ARGS+=("$(build_packet back)")
  CODEX_LAUNCH="$(shell_join "${CODEX_ARGS[@]}")"
}

print_plan() {
  local i
  echo "agent=$agent"
  echo "slug=$slug"
  if [ "$agent" = codex ]; then
    build_codex_launch
    echo "topology=primary-plus-two-agent-threads"
    echo "canonical=${WORKTREES[$CANONICAL_INDEX]}"
    for i in "${!REPOS[@]}"; do
      [ "$i" -eq "$CANONICAL_INDEX" ] || echo "worker=${REPOS[$i]}:${WORKTREES[$i]}"
    done
    echo "command=$CODEX_LAUNCH"
  else
    echo "topology=three-named-top-level-sessions"
    for i in "${!REPOS[@]}"; do
      echo "session=$slug-${REPOS[$i]} path=${WORKTREES[$i]}"
      if [ "$agent" = claude ]; then
        build_claude_launch "${REPOS[$i]}"
        echo "command=$CLAUDE_LAUNCH"
      fi
    done
  fi
}

open_codex() {
  local pane_id surface_id canonical
  canonical="${WORKTREES[$CANONICAL_INDEX]}"
  build_codex_launch
  create_workspace "$canonical"
  pane_id="$CREATED_PANE_ID"
  surface_id="$(find_surface "$pane_id")"

  cmux send --workspace "$workspace_id" --surface "$surface_id" -- "$CODEX_LAUNCH"$'\n' >/dev/null 2>&1
  cmux rename-tab --surface "$surface_id" --workspace "$workspace_id" -- back >/dev/null 2>&1 || true

  echo "primary Codex listo: $pane_id"
  echo "  backend: $canonical"
  echo "  workers: ${REPOS[*]} (dos agent threads dentro del primary)"
}

open_top_level_sessions() {
  local i pane_id surface_id direction=right launch
  for i in "${!REPOS[@]}"; do
    if [ "$i" -eq 0 ]; then
      create_workspace "${WORKTREES[$i]}"
      pane_id="$CREATED_PANE_ID"
    else
      create_pane "$direction"
      pane_id="$CREATED_PANE_ID"
      direction=down
    fi
    surface_id="$(find_surface "$pane_id")"

    if [ "$agent" = claude ]; then
      build_claude_launch "${REPOS[$i]}"
      launch="$CLAUDE_LAUNCH"
    else
      launch="$(shell_join "$agent")"
    fi
    cmux send --workspace "$workspace_id" --surface "$surface_id" -- \
      "cd $(printf '%q' "${WORKTREES[$i]}") && $launch"$'\n' >/dev/null 2>&1
    cmux rename-tab --surface "$surface_id" --workspace "$workspace_id" -- "${REPOS[$i]}" >/dev/null 2>&1 || true
    echo "pane ${REPOS[$i]} listo: $pane_id (agente $agent, sesión $slug-${REPOS[$i]})"
  done
}


cmd="${1:-}"
[ -n "$cmd" ] || usage
shift || true

case "$cmd" in
  claude|codex|opencode)
    agent="$cmd"
    slug="${1:?falta el feature-slug}"
    shift || true
    repos=""
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --force) shift ;;
        *) repos="$1"; shift ;;
      esac
    done
    repos="${repos:-$(default_repos)}"
    cmd=start
    ;;
  start)
    agent="$DEFAULT_AGENT"
    slug="${1:?falta el feature-slug}"
    shift || true
    repos="$(default_repos)"
    repos_set=0
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --agent)
          [ "$#" -ge 2 ] || usage
          agent="$2"
          shift 2
          ;;
        --agent=*) agent="${1#*=}"; shift ;;
        --force) shift ;;
        *)
          [ "$repos_set" -eq 0 ] || usage
          repos="$1"
          repos_set=1
          shift
          ;;
      esac
    done
    ;;
  plan)
    agent="${1:?falta el agente}"
    slug="${2:?falta el feature-slug}"
    repos="${3:-$(default_repos)}"
    cmd=plan
    ;;
  resume)
    : "${1:?falta el repo-name}"
    slug="${2:?falta el feature-slug}"
    shift 2 || true
    while [ "$#" -gt 0 ]; do
      case "$1" in
        --force) shift ;;
        *) usage ;;
      esac
    done
    ;;
  stop|list|close|waits|seed) ;;
  *) usage ;;
esac

case "$cmd" in
  start|plan)
    validate_agent "$agent"
    load_repositories "$repos"
    CANONICAL_IDENTITY=$(validate_fresh_identity)
    RUN_NONCE=$(python3 -c 'import secrets; print(secrets.token_hex(16))')
    AUTHORITY_CONTEXT="Canonical OpenSpec authority: $CANONICAL_IDENTITY. Implementation BLOCKED until exact artifacts exist; only back may create this exact plan."
    echo "$AUTHORITY_CONTEXT"
    if [ "$cmd" = plan ]; then
      print_plan
      exit 0
    fi

    assert_fresh_targets
    cmux list-workspaces >/dev/null 2>&1 || blocked 'authorized cmux transport unavailable; no launch mutations'
    reserve_launch
    ensure_worktrees
    ensure_devtools
    workspace_id=""
    if [ "$agent" = codex ]; then
      open_codex
    else
      open_top_level_sessions
    fi
    echo
    echo "Topología '$slug' lanzada en workspace $workspace_id; coordinación viva UNTESTED."

    echo "Auditoría QA disponible en http://localhost:7777"
    ;;

  waits)
    slug="${1:?falta el feature-slug}"
    shift || true
    repos="${1:-$(default_repos)}"
    [[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "BLOCKED: slug inválido" >&2; exit 1; }
    load_repositories "$repos"
    show_waits
    exit 0
    ;;

  seed)
    # Re-siembra worktrees YA creados (los anteriores a esta versión nacieron
    # sin .env). Misma regla: sólo ignorados, nunca pisa, nunca muestra valores.
    slug="${1:?falta el feature-slug}"
    shift || true
    repos="${1:-$(default_repos)}"
    [[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "BLOCKED: slug inválido" >&2; exit 1; }
    load_repositories "$repos"
    result=0
    for i in "${!REPOS[@]}"; do
      if [ ! -d "${WORKTREES[$i]}" ]; then
        echo "BLOCKED: no existe el worktree ${WORKTREES[$i]}" >&2; result=1; continue
      fi
      echo "${REPOS[$i]}: ${WORKTREES[$i]}"
      seed_worktree_includes "${REPO_BASES[$i]}" "${WORKTREES[$i]}"
    done
    exit "$result"
    ;;

  stop)
    slug="${1:?falta el feature-slug}"
    shift || true
    repos="${1:-$(default_repos)}"
    [[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "BLOCKED: slug inválido" >&2; exit 1; }
    IFS=',' read -ra REPOS <<< "$repos"
    result=0
    export GIT_OPTIONAL_LOCKS=0
    echo "DIAGNOSTIC: stop solo inspecciona; no elimina datos ni detiene sesiones."
    for name in "${REPOS[@]}"; do
      base="$(repo_path "$name")"
      if [ -z "$base" ]; then
        echo "BLOCKED: repo desconocido $name" >&2; result=1; continue
      fi
      wt="$base/.claude/worktrees/triangulate-$slug"
      if [ ! -d "$wt" ]; then
        echo "BLOCKED: worktree ausente/no verificable: $wt; preservar registro y rama." >&2
        result=1; continue
      fi
      if ! physical="$(cd "$wt" && pwd -P)" \
        || ! top="$(git -C "$wt" rev-parse --show-toplevel)" \
        || [ "$top" != "$physical" ] \
        || ! common="$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir)" \
        || ! owner="$(git -C "$base" rev-parse --path-format=absolute --git-common-dir)" \
        || [ "$common" != "$owner" ]; then
        echo "BLOCKED: raíz/propiedad Git no verificable: $wt" >&2; result=1; continue
      fi
      if ! status="$(git -C "$wt" status --short --branch --untracked-files=all --ignored=matching)"; then
        echo "BLOCKED: estado Git desconocido: $wt" >&2; result=1; continue
      fi
      printf '[%s] %s\n%s\n' "$name" "$wt" "$status"
      if ! upstream="$(git -C "$wt" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}')" \
        || ! ahead="$(git -C "$wt" rev-list --count "$upstream..HEAD")"; then
        echo "BLOCKED: publicación desconocida; falta upstream/ref verificable: $wt" >&2
        result=1; continue
      fi
      echo "ahead=$ahead respecto a ref local $upstream (sin fetch; no prueba publicación remota)."
    done
    echo "Propiedad de sesiones UNKNOWN: contactar al escritor actual; este diagnóstico no libera propiedad."
    echo "Revisar cambios y recibos antes de coordinar commit/push; todos los worktrees y ramas se conservan."
    exit "$result"
    ;;

  close)
    # close — cierra una triangulación TERMINADA: remueve sus worktrees y su
    # alias en triangulate-changes.conf. A diferencia de `stop` (que solo
    # diagnostica), acá sí se borra, pero únicamente cuando el worktree no
    # puede perder nada: árbol limpio, upstream presente, ahead=0 y ninguna
    # sesión Claude/Codex con el cwd adentro. Cualquier duda => BLOCKED y ese
    # worktree se conserva; los demás del mismo slug se procesan igual.
    #
    # Nace de la auditoría 2026-09-17: cuatro triangulaciones vivas 28h con su
    # SDD archivado, porque nada ataba el cierre del change al cierre de los
    # panes. sdd-archive invoca esto cuando el change tiene alias en el conf.
    #
    #   triangulate close <feature-slug> [repos] [--dry-run]
    slug="${1:?falta el feature-slug}"
    shift || true
    dry_run=0
    repos=""
    for arg in "$@"; do
      case "$arg" in
        --dry-run) dry_run=1 ;;
        *) repos="$arg" ;;
      esac
    done
    [ -n "$repos" ] || repos="$(default_repos)"
    [[ "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]] || { echo "BLOCKED: slug inválido" >&2; exit 1; }
    IFS=',' read -ra REPOS <<< "$repos"
    changes_conf="${TRIANGULATE_CHANGES_CONFIG:-$HOME/.claude/triangulate-changes.conf}"
    result=0
    removed=0
    remaining=0
    export GIT_OPTIONAL_LOCKS=0
    # cwd de cada proceso claude/codex vivo, una sola vez. Por PID y no con
    # `lsof -c claude`: en esta Mac ese filtro devuelve vacío para los binarios
    # de Claude (verificado 2026-09-17) y un vacío acá significa "removí el
    # worktree debajo de una sesión viva". Un pgrep sin resultados es válido.
    live_pids="$( { pgrep -x claude; pgrep -x codex; } 2>/dev/null | sort -u || true)"
    live_cwds=""
    for pid in $live_pids; do
      live_cwds="$live_cwds
$(lsof -p "$pid" -a -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' || true)"
    done
    [ "$dry_run" -eq 1 ] && echo "DRY-RUN: no se remueve nada; solo se informa qué pasaría."
    for name in "${REPOS[@]}"; do
      base="$(repo_path "$name")"
      if [ -z "$base" ]; then
        echo "BLOCKED: repo desconocido $name" >&2; result=1; continue
      fi
      wt="$base/.claude/worktrees/triangulate-$slug"
      if [ ! -d "$wt" ]; then
        echo "[$name] ya no existe: $wt"
        continue
      fi
      if ! physical="$(cd "$wt" && pwd -P)" \
        || ! top="$(git -C "$wt" rev-parse --show-toplevel)" \
        || [ "$top" != "$physical" ] \
        || ! common="$(git -C "$wt" rev-parse --path-format=absolute --git-common-dir)" \
        || ! owner="$(git -C "$base" rev-parse --path-format=absolute --git-common-dir)" \
        || [ "$common" != "$owner" ]; then
        echo "BLOCKED [$name]: raíz/propiedad Git no verificable: $wt" >&2; result=1; remaining=$((remaining+1)); continue
      fi
      if ! porcelain="$(git -C "$wt" status --porcelain --untracked-files=all)"; then
        echo "BLOCKED [$name]: estado Git desconocido: $wt" >&2; result=1; remaining=$((remaining+1)); continue
      fi
      dirty="$(printf '%s\n' "$porcelain" | grep -cv '^\(!!\|$\)' || true)"
      if [ "$dirty" -gt 0 ]; then
        echo "BLOCKED [$name]: $dirty archivo(s) sin commitear en $wt; commit/push primero." >&2
        result=1; remaining=$((remaining+1)); continue
      fi
      branch="$(git -C "$wt" branch --show-current 2>/dev/null || true)"
      if ! upstream="$(git -C "$wt" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null)" \
        || ! ahead="$(git -C "$wt" rev-list --count "$upstream..HEAD" 2>/dev/null)"; then
        echo "BLOCKED [$name]: rama ${branch:-detached} sin upstream en $wt; push -u primero." >&2
        result=1; remaining=$((remaining+1)); continue
      fi
      if [ "$ahead" -gt 0 ]; then
        echo "BLOCKED [$name]: $ahead commit(s) sin pushear en $branch ($wt)." >&2
        result=1; remaining=$((remaining+1)); continue
      fi
      if printf '%s\n' "$live_cwds" | grep -Fxq "$physical"; then
        echo "BLOCKED [$name]: hay una sesión Claude/Codex viva con cwd en $wt; cerrala primero." >&2
        result=1; remaining=$((remaining+1)); continue
      fi
      echo "[$name] limpio: rama $branch, ahead=0 sobre $upstream, sin sesión viva."
      if [ "$dry_run" -eq 1 ]; then
        echo "[$name] se removería: $wt"
        continue
      fi
      if git -C "$base" worktree remove "$wt"; then
        echo "[$name] removido: $wt (la rama $branch se conserva en local y en origin)"
        removed=$((removed+1))
      else
        echo "BLOCKED [$name]: git worktree remove falló; se conserva $wt" >&2
        result=1; remaining=$((remaining+1))
      fi
    done
    if [ "$dry_run" -eq 0 ] && [ "$remaining" -eq 0 ] && [ -f "$changes_conf" ] \
      && grep -q "^triangulate-$slug=" "$changes_conf"; then
      tmp="$(mktemp)"
      grep -v "^triangulate-$slug=" "$changes_conf" > "$tmp" || true
      mv "$tmp" "$changes_conf"
      echo "alias triangulate-$slug retirado de $changes_conf"
    fi
    if [ "$remaining" -gt 0 ]; then
      echo "Quedan $remaining worktree(s) conservados por bloqueo; resolvé cada BLOCKED y volvé a correr close." >&2
    fi
    echo "Panes/sesiones de esta triangulación (cerrarlas a mano en cmux si siguen abiertas):"
    for name in "${REPOS[@]}"; do echo "  $slug-$name"; done
    [ "$dry_run" -eq 0 ] && echo "removidos: $removed"
    exit "$result"
    ;;

  resume)
    blocked "resume requires explicit owner handoff; continue through the existing native owner, never --force"
    ;;

  list)
    for name in $(repo_names); do
      base="$(repo_path "$name")"
      [ -n "$base" ] || continue
      git -C "$base" worktree list 2>/dev/null | grep 'triangulate-' | sed "s#^#[$name] #" || true
    done
    ;;
esac

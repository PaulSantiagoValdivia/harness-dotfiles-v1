#!/usr/bin/env python3
"""Explicit, source-only local exclusions; immutable backup receipts, no network."""
import base64
import hashlib
import json
import os
import stat
import subprocess
import sys
from pathlib import Path

RULES = [b"/.claude/worktrees/", b"/.atl/"]


def digest(data):
    return hashlib.sha256(data).hexdigest()


def locate(root):
    root = Path(root).resolve(strict=True)
    if not (root / ".git").exists():
        raise ValueError("not a checkout root")
    def git(*args):
        return subprocess.check_output(["git", "-C", str(root), *args],
                                      env={**os.environ, "GIT_OPTIONAL_LOCKS": "0"}).decode().strip()
    if Path(git("rev-parse", "--show-toplevel")).resolve() != root:
        raise ValueError("ancestor discovery is not a checkout root")
    common = (root / git("rev-parse", "--git-common-dir")).resolve(strict=True)
    info = common / "info"
    if info.is_symlink() or not info.is_dir():
        raise ValueError("unexpected Git info directory")
    return root, info


def read_at(directory, name):
    try:
        fd = os.open(name, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK, dir_fd=directory)
    except FileNotFoundError:
        return None
    with os.fdopen(fd, "rb") as source:
        if not stat.S_ISREG(os.fstat(source.fileno()).st_mode):
            raise ValueError("expected a regular file")
        return source.read()


def read_path(path):
    directory = os.open(path.parent, os.O_RDONLY | os.O_DIRECTORY)
    try:
        return read_at(directory, path.name)
    finally:
        os.close(directory)


def create(path, data):
    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    with os.fdopen(fd, "wb") as target:
        target.write(data)
        target.flush()
        os.fsync(target.fileno())


def replace(directory, expected, content):
    fd = os.open("exclude.lock", os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                 0o600, dir_fd=directory)
    try:
        with os.fdopen(fd, "wb") as target:
            if expected is not None:
                mode = os.stat("exclude", dir_fd=directory, follow_symlinks=False).st_mode
                os.fchmod(target.fileno(), stat.S_IMODE(mode))
            target.write(content)
            target.flush()
            os.fsync(target.fileno())
        if read_at(directory, "exclude") != expected:
            raise ValueError("content drift; refusing replacement")
        os.replace("exclude.lock", "exclude", src_dir_fd=directory, dst_dir_fd=directory)
    except BaseException:
        os.unlink("exclude.lock", dir_fd=directory)
        raise


def main():
    action, *args = sys.argv[1:]
    if action == "prepare" and len(args) == 2:
        root, info = locate(args[0])
        receipt = Path(args[1])
    elif action in ("apply", "rollback") and len(args) == 1:
        receipt = Path(args[0])
        raw = read_path(receipt)
        saved = json.loads(raw)
        root, info = locate(saved["root"])
        if str(info) != saved["info"]:
            raise ValueError("Git common directory changed")
    else:
        raise ValueError("usage: prepare ROOT RECEIPT | apply RECEIPT | rollback RECEIPT")
    directory = os.open(info, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        current = read_at(directory, "exclude")
        if action == "prepare":
            before = current or b""
            added = [rule.decode() for rule in RULES if rule not in before.splitlines()]
            saved = dict(root=str(root), info=str(info), before=base64.b64encode(before).decode(),
                         existed=current is not None, sha256=digest(before), added=added)
            create(receipt, json.dumps(saved, indent=2).encode() + b"\n")
        else:
            before = base64.b64decode(saved["before"], validate=True)
            added = [rule.encode() for rule in saved["added"]]
            if digest(before) != saved["sha256"] or added != [r for r in RULES if r not in before.splitlines()]:
                raise ValueError("invalid backup or rule plan")
            after = before + (b"\n" if before and not before.endswith(b"\n") and added else b"")
            after += b"".join(rule + b"\n" for rule in added)
            marker = receipt.with_name(receipt.name + ".applied")
            applied = read_path(marker)
            rolled = receipt.with_name(receipt.name + ".rolled-back")
            rolled_data = read_path(rolled)
            if rolled_data is not None:
                if rolled_data != digest(raw).encode() or action != "rollback":
                    raise ValueError("closed receipt; prepare a new operation")
                print(json.dumps(dict(action=action, status="already rolled back", receipt=str(receipt))))
                return
            if applied is not None and applied != digest(raw).encode():
                raise ValueError("application receipt mismatch")
            if action == "apply":
                if applied is not None:
                    if current != after:
                        raise ValueError("content drift after application")
                else:
                    expected = before if saved["existed"] else None
                    if current != expected:
                        raise ValueError("content drift since prepare")
                    if current != after:
                        replace(directory, current, after)
                    create(marker, digest(raw).encode())
            else:
                if applied is None:
                    raise ValueError("no application receipt; refusing rollback")
                lines = (current or b"").splitlines(keepends=True)
                counts = [sum(line.rstrip(b"\r\n") == rule for line in lines) for rule in added]
                if current == after:
                    if current != before:
                        replace(directory, current, before)
                elif any(counts):
                    if not all(count == 1 for count in counts):
                        raise ValueError("ambiguous rule ownership; inspect manually")
                    remaining = b"".join(line for line in lines if line.rstrip(b"\r\n") not in added)
                    replace(directory, current, remaining)
                create(rolled, digest(raw).encode())
        print(json.dumps(dict(action=action, receipt=str(receipt), target=str(info / "exclude"),
                              sha256=digest(read_at(directory, "exclude") or b""))))
    finally:
        os.close(directory)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, KeyError, TypeError, subprocess.CalledProcessError) as error:
        print(f"ERROR: {error}", file=sys.stderr)
        sys.exit(1)
